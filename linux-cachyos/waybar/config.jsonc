// Waybar — ~/.config/waybar/config.jsonc
// Replaces macOS sketchybar. Shows Hyprland workspaces 1–9 + a right-side tray.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,

  "modules-left":   ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["hyprland/window"],
  "modules-right":  ["tray", "pulseaudio", "network", "cpu", "memory", "clock"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    }
  },

  "hyprland/submap": {
    "format": " {}",
    "tooltip": false
  },

  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "cpu":    { "format": " {usage}%" },
  "memory": { "format": " {}%" },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ipaddr}",
    "format-disconnected": "  offline",
    "tooltip-format": "{ifname}: {ipaddr}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol"
  },

  "tray": { "spacing": 10 }
}
