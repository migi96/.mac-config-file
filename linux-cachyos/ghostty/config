# Ghostty config — LINUX / CachyOS   (~/.config/ghostty/config)
# Ported from the macOS ghostty config. macOS-only keys removed; the herdr
# prefix passthrough and Arabic (wisp) font mapping are kept — those are the
# parts that matter for your workflow. Validate:  ghostty +validate-config
#
# On Linux, window/tab/split management is handled by Hyprland + herdr, so the
# old `cmd+n>...` ghostty leader chords are intentionally dropped (see bottom).

# ─────────────────────────────────────────────
# Shell
# ─────────────────────────────────────────────
# Launch the default login shell (set your login shell to zsh so atuin history
# works:  chsh -s /usr/bin/zsh). shell-integration=detect auto-injects zsh OSC.
shell-integration = detect

# ─────────────────────────────────────────────
# Font  (install these on Linux — see README: fonts go in ~/.local/share/fonts)
# ─────────────────────────────────────────────
font-family = ProFont IIx Nerd Font
font-size = 20

# ─────────────────────────────────────────────
# Arabic → Kawkab Mono  (wisp pre-shapes into Presentation Forms; the patched
# Kawkab Mono covers them 1:1). Ranges are the patched font's verified coverage
# — do not widen. On Linux the patched .otf goes in ~/.local/share/fonts/.
# ─────────────────────────────────────────────
font-codepoint-map = U+060C,U+0615,U+061B,U+061F,U+0621-U+063A,U+0640-U+0656,U+0658,U+0660-U+0671=Kawkab Mono
font-codepoint-map = U+0679,U+067E,U+0686,U+0688,U+0691,U+0698,U+06A1,U+06A4,U+06A9,U+06AF,U+06BA,U+06BE,U+06C1-U+06C3,U+06CC,U+06D2-U+06D4,U+06F0-U+06F9=Kawkab Mono
font-codepoint-map = U+FB50-U+FB51,U+FB56-U+FB59,U+FB66-U+FB6D,U+FB7A-U+FB7D,U+FB88-U+FB95,U+FB9E-U+FB9F,U+FBA6-U+FBB9,U+FBBD-U+FBBE,U+FBFC-U+FBFF=Kawkab Mono
font-codepoint-map = U+FCCC,U+FCD1,U+FD3E-U+FD3F,U+FDF2,U+FE80-U+FEFC=Kawkab Mono

# ─────────────────────────────────────────────
# Cursor
# ─────────────────────────────────────────────
cursor-style = block

# ─────────────────────────────────────────────
# Colors
# ─────────────────────────────────────────────
foreground = #dddddd
background = #1a1a1a
palette = 0=#000000
palette = 8=#767676
palette = 1=#cc0403
palette = 9=#f2201f
palette = 2=#19cb00
palette = 10=#23fd00
palette = 3=#cecb00
palette = 11=#ffff00
palette = 4=#0d73cc
palette = 12=#1a8fff
palette = 5=#cb1ed1
palette = 13=#fd28ff
palette = 6=#0dcdcd
palette = 14=#14ffff
palette = 7=#dddddd
palette = 15=#ffffff

# ─────────────────────────────────────────────
# Background image  (macOS path removed — the png never existed there anyway).
# To use one on Linux, point at a real file:
# background-image = /home/YOU/Pictures/wallpaper.png
# background-image-fit = stretch
# background-image-opacity = 0.8
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Opacity / blur — fully opaque = fastest. For the translucent look, use
# background-opacity = 0.9 (Hyprland's own blur will then blur behind it).
# ─────────────────────────────────────────────
background-opacity = 1
background-blur = false

window-padding-x = 0
window-padding-y = 0

# ─────────────────────────────────────────────
# herdr prefix (ctrl+n) — send the raw 0x0E byte regardless of active keyboard
# layout, so the prefix always fires even with the Arabic layout active.
# ─────────────────────────────────────────────
keybind = ctrl+n=text:\x0e

# Ctrl+C = SIGINT on ANY layout (send raw 0x03 / ETX).
keybind = ctrl+c=text:\x03

# Reload config live
keybind = ctrl+shift+comma=reload_config

copy-on-select = clipboard
mouse-hide-while-typing = true
window-save-state = always

# ─────────────────────────────────────────────
# DROPPED on Linux (were macOS `cmd+...` binds):
#   - cmd+j=text:\x1bj            (nchat goto-chat)
#   - cmd+n>... leader chords     (new tab/window/split, goto/move tab, splits)
#   - macos-option-as-alt         (macOS-only)
# Window management now lives in Hyprland (SUPER binds) and terminal multiplexing
# in herdr (ctrl+n prefix), so these ghostty-level chords are redundant here.
# ─────────────────────────────────────────────
